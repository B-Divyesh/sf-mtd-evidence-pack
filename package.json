{
  "name": "mtd-evidence-pack",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "verify:url": "bash scripts/verify-url.sh",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --config vitest.config.ts && playwright test",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.7.62"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
